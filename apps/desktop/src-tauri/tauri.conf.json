{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Savoir",
  "version": "0.1.0",
  "identifier": "agency.echo.savoir",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm --dir ../mcp build && pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Savoir",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "backgroundColor": "#1E1830",
        "decorations": false,
        "transparent": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "rpm",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "resources": {
      "../../mcp/dist/index.js": "mcp/karakeep-mcp.js"
    }
  }
}
